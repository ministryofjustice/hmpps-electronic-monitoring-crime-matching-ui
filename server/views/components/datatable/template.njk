{% from "govuk/components/pagination/macro.njk" import govukPagination %}
{% from "govuk/components/table/macro.njk" import govukTable %}

{# Tables default to a smaller font size (govuk-!-font-size-16). GOV.UK's govuk-!-*
   If a font-size is passed in to a specific table as part of tableClasses,
   it will be used instead of the default. #}
{% set hasCustomFontSize = params.tableClasses and "font-size" in params.tableClasses %}
{% set tableClasses = params.tableClasses if hasCustomFontSize else (("govuk-!-font-size-16 " + params.tableClasses) if params.tableClasses else "govuk-!-font-size-16") %}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-full">
    <div class="datatable {% if params.classes %}{{ params.classes }}{% endif %}">
      {% if params.rows.length %}
        {{
          govukTable({
            caption: params.caption,
            captionClasses: params.captionClasses,
            head: params.columns,
            rows: params.rows,
            classes: tableClasses
          })
        }}

        {% if params.pagination.pageCount > 1 %}
          {{
            govukPagination(
              pagination(
                params.pagination.currentPage,
                params.pagination.pageCount,
                params.pagination.hrefPrefix
              )
            )
          }}
        {% endif %}
      {% else %}
        <p class="govuk-body" data-qa="no-results-message">There are no results.</p>
      {% endif %}
    </div>
  </div>
</div>
