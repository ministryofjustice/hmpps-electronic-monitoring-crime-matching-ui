{
  "name": "hmpps-electronic-monitoring-crime-matching-ui",
  "version": "0.0.1",
  "description": "HMPPS Electronic Monitoring Crime Matching Ui",
  "repository": "git@github.com:ministryofjustice/hmpps-electronic-monitoring-crime-matching-ui.git",
  "license": "MIT",
  "scripts": {
    "prepare": "hmpps-precommit-hooks-prepare",
    "watch-ts": "tsc -w",
    "build": "node esbuild/esbuild",
    "start": "node $NODE_OPTIONS dist/server.js | bunyan -o short",
    "start:dev": "node esbuild/esbuild --watch",
    "start-feature": " node $NODE_DEBUG_OPTION --env-file=feature.env dist/server.js | bunyan -o short",
    "start-feature:dev": "node esbuild/esbuild --watch --env feature.env",
    "lint": "eslint . --cache --max-warnings 0",
    "lint-fix": "eslint . --cache --max-warnings 0 --fix",
    "typecheck": "tsc && tsc -p integration_tests",
    "test": "jest",
    "test:ci": "jest --runInBand",
    "security_audit": "npx audit-ci --config audit-ci.json",
    "int-test": "cypress run --config video=false",
    "int-test-ui": "cypress open --e2e --browser chrome",
    "int-test-init:ci": "npx playwright install",
    "clean": "rm -rf dist test_results",
    "rebuild": "npm run clean && npm run setup && npm run build",
    "setup": "npm ci"
  },
  "engines": {
    "node": "^26",
    "npm": "^12"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1164.0",
    "@ministryofjustice/frontend": "^12.0.0",
    "@ministryofjustice/hmpps-auth-clients": "3.0.0",
    "@ministryofjustice/hmpps-azure-telemetry": "1.3.0",
    "@ministryofjustice/hmpps-electronic-monitoring-components": "0.8.0",
    "@ministryofjustice/hmpps-monitoring": "2.1.0",
    "@ministryofjustice/hmpps-probation-frontend-components": "1.2.2",
    "@ministryofjustice/hmpps-rest-client": "2.2.0",
    "@types/archiver": "8.0.0",
    "@types/qs": "^6.15.1",
    "agentkeepalive": "^4.6.0",
    "axios": "1.21.0",
    "bunyan": "^1.8.15",
    "bunyan-format": "^0.2.1",
    "compression": "^1.8.2",
    "connect-flash": "^0.1.1",
    "connect-redis": "^11.0.0",
    "csrf-sync": "^4.2.1",
    "csv-stringify": "6.9.0",
    "dayjs": "^1.11.23",
    "docx": "9.15.3",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "file-type": "22.3.0",
    "govuk-frontend": "^6.6.0",
    "helmet": "^8.3.0",
    "http-errors": "^2.0.1",
    "image-size": "2.1.0",
    "jwt-decode": "^4.0.0",
    "multer": "2.5.0",
    "nocache": "^4.0.0",
    "nunjucks": "^3.2.4",
    "ol": "^10.11.0",
    "passport": "^0.7.0",
    "passport-oauth2": "^1.8.0",
    "playwright": "1.65.0",
    "redis": "6.3.1",
    "superagent": "^10.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@jgoz/esbuild-plugin-typecheck": "^5.0.0",
    "@ministryofjustice/eslint-config-hmpps": "1.0.4",
    "@ministryofjustice/hmpps-precommit-hooks": "3.0.2",
    "@tsconfig/node26": "^26.0.1",
    "@types/bunyan": "^1.8.11",
    "@types/bunyan-format": "^0.2.9",
    "@types/compression": "^1.8.1",
    "@types/connect-flash": "0.0.40",
    "@types/express-session": "^1.19.0",
    "@types/govuk-frontend": "6.6.0",
    "@types/http-errors": "^2.0.5",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "2.3.0",
    "@types/node": "^26.6.6",
    "@types/nunjucks": "^3.2.6",
    "@types/passport": "^1.0.17",
    "@types/passport-oauth2": "^1.8.0",
    "@types/superagent": "^8.1.11",
    "@types/supertest": "^7.2.1",
    "audit-ci": "^7.1.0",
    "aws-sdk-client-mock": "^4.1.0",
    "concurrently": "^10.0.7",
    "cypress": "^16.2.1",
    "cypress-multi-reporters": "^2.1.0",
    "del": "9.0.1",
    "esbuild": "0.28.2",
    "esbuild-plugin-clean": "^1.0.1",
    "esbuild-plugin-copy": "^2.1.1",
    "esbuild-plugin-manifest": "^1.0.5",
    "esbuild-sass-plugin": "^3.7.0",
    "glob": "^14.0.4",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-html-reporter": "^4.4.3",
    "jest-junit": "17.0.0",
    "jsonwebtoken": "^9.0.3",
    "lint-staged": "^16.4.0",
    "mocha-junit-reporter": "^2.2.1",
    "nock": "^15.0.6",
    "prettier": "^3.9.10",
    "prettier-plugin-jinja-template": "^2.2.0",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3",
    "uuid": "^14.0.3"
  },
  "overrides": {
    "@ministryofjustice/hmpps-azure-telemetry@1.3.0": {
      "@opentelemetry/instrumentation-http": "0.223.0"
    },
    "@opentelemetry/core": "2.12.0",
    "diff": "9.0.0",
    "glob@>=9.0.0 <=14.0.1": "14.0.4",
    "proxy-addr": "2.0.8",
    "serialize-javascript": "7.1.4",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.21"
    },
    "minimatch@>=7.0.0 <11.0.1": "11.0.5",
    "shell-quote": "1.12.0"
  },
  "overrides-comments": {
    "glob@>=9.0.0 <=14.0.1": "https://github.com/advisories/GHSA-3g3m-2fjr-6pw4",
    "minimatch@>=7.0.0 <11.0.1": "https://github.com/advisories/GHSA-g3hv-75wg-m249"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "cypress@16.2.1": true,
    "dtrace-provider@0.8.8": false,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.2": true
  }
}
